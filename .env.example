# Algo-Merlin — Environment Variables
# Copy this file to .env and fill in your values

# Database
DB_PASSWORD=your_secure_password_here

# BingX Demo API (get from BingX demo account settings)
BINGX_API_KEY=your_bingx_api_key
BINGX_API_SECRET=your_bingx_api_secret

# OpenRouter (get from openrouter.ai)
OPENROUTER_API_KEY=your_openrouter_api_key

# Telegram (create bot via @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# GitHub Actions (for claude-code-action)
# Set ANTHROPIC_API_KEY in GitHub repo secrets, not here
